generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================================================
// ====================                     ENUM                          =================
// ==========================================================================================

enum Quyen {
  USER
  LANHDAOPHONG
  LANHDAODONVI
}

enum GioiTinh {
  NAM
  NU
  KHAC
}

enum LoaiGhiNhan {
  KEHOACH
  BAOCAO
}

// CHƯA CHỐT: HOATOC chưa xác nhận có dùng thật trong dropdown hay không. Giữ trong enum vì thêm 1
// giá trị sau này (ALTER TYPE ... ADD VALUE) dễ hơn nhiều so với xoá bớt giá trị đã có dữ liệu
// dùng. UI form Nhiệm vụ chỉ hiển thị 2 lựa chọn THUONG/KHAN, không migrate xoá HOATOC.
enum MucDoUuTien {
  THUONG
  KHAN
  HOATOC
}

enum TrangThaiNhiemVu {
  CHO_PHAN_CONG
  DANGXULY
  CHO_DUYET
  HOANTHANH
  TAMDUNG
  HUY
}

enum HanhDongNhiemVu {
  TAO_MOI
  PHAN_CONG
  CHUYEN_TIEP              // dự phòng, CHƯA dùng cho luồng chính (khác THAY_DOI_PHONG_CHU_TRI)
  CAP_NHAT_TIENDO
  DONG_GOP_PHOIHOP
  BAO_CAO_HOANTHANH
  YEU_CAU_XULY_LAI
  DUYET_HOANTHANH
  MO_LAI
  TAMDUNG                  // đối xứng với HUY — bắt buộc để ghi log khi chuyển sang TrangThaiNhiemVu.TAMDUNG
  HUY
  THAY_DOI_HAN
  THAY_DOI_NGUOIXULY
  THAY_DOI_PHONG_CHU_TRI   // chỉ BGĐ (LANHDAODONVI)
  THAY_DOI_NOI_DUNG        // sửa tieuDe/noiDung — chỉ cho phép khi CHO_PHAN_CONG/DANGXULY
  THAY_DOI_UU_TIEN         // sửa mucDoUuTien — cùng điều kiện với trên
  HOAN_THANH_DOT_DINH_KY   // riêng cho "Xong đợt" của nhiệm vụ định kỳ, KHÔNG dùng BAO_CAO_HOANTHANH
}

enum TanSuatNhac {
  HANG_TUAN
  HANG_THANG
  HANG_QUY
  HANG_NAM
}

enum LoaiThongBao {
  NHIEM_VU_DUOC_GIAO
  NHIEM_VU_PHAN_CONG
  NHIEM_VU_CHO_DUYET
  NHIEM_VU_DA_DUYET
  NHIEM_VU_YEU_CAU_LAM_LAI
  NHIEM_VU_SAP_DEN_HAN
  NHIEM_VU_QUA_HAN
  NHIEM_VU_DINH_KY_NHAC
  // mở rộng sau: ALTER TYPE ... ADD VALUE, không cần đổi cột
}

// ---- MỚI: Checklist Giao ban ----
enum TrangThaiCuocHopGiaoBan {
  DANG_MO
  DA_CHOT
}

// Thang riêng cho Giao ban — CAO/TRUNGBINH/THAP theo đúng dữ liệu Excel gốc, KHÔNG dùng chung
// enum MucDoUuTien (THUONG/KHAN/HOATOC) của Nhiệm vụ vì ngữ nghĩa khác hẳn.
enum MucDoUuTienGiaoBan {
  CAO
  TRUNGBINH
  THAP
}

enum HanhDongGiaoBan {
  TAO_NOI_DUNG
  CHUYEN_TU_NHIEM_VU
  CHUYEN_TU_KE_HOACH_PHONG
  CAP_NHAT_NOI_DUNG
  SUA_PHONG_XU_LY
  THEM_NGUOI_XU_LY
  XOA_NGUOI_XU_LY
  SUA_HAN_HOAN_THANH
  SUA_MUC_DO_UU_TIEN
  CAP_NHAT_GHI_CHU
  HOAN_THANH
  BO_HOAN_THANH
  CHUYEN_TUAN_SAU
  XAC_NHAN_CHUYEN_TUAN
  HUY_KHONG_THEO_DOI
  DONG_BO_HOAN_THANH
  KHOI_PHUC
}

// ==========================================================================================
// ====================                DANH MỤC                           =================
// ==========================================================================================

model Phong {
  maPhong  String  @id @map("ma_phong")
  tenPhong String  @map("ten_phong")
  thuTu    Int     @default(999) @map("thu_tu")
  hoatDong Boolean @default(true) @map("hoat_dong")

  nhanViens    NhanVien[]
  keHoachTuans KeHoachTuan[]

  nhiemVuChuTri  NhiemVu[]      @relation("NhiemVuPhongChuTri")
  nhiemVuPhoiHop NhiemVuPhong[]

  nhiemVuNguoiPhoiHop NhiemVuNguoiPhoiHop[] // snapshot phòng của người phối hợp tại thời điểm thêm

  // MỚI — Giao ban: phòng chịu trách nhiệm xử lý nội dung
  noiDungGiaoBanXuLy NoiDungGiaoBan[]

  @@map("phong")
}

model NhanVien {
  maNV        String    @id @map("ma_nv")
  hoTen       String    @map("ho_ten")
  maPhong     String    @map("ma_phong")
  thuTu       Int       @default(999) @map("thu_tu")
  chucVu      String?   @map("chuc_vu")
  hoatDong    Boolean   @default(true) @map("hoat_dong")
  quyen       Quyen     @default(USER) // vai trò NGHIỆP VỤ — KHÔNG dùng cho quyền quản trị hệ thống, xem TaiKhoan.isAdmin

  ngaySinh    DateTime? @map("ngay_sinh") @db.Date
  gioiTinh    GioiTinh? @map("gioi_tinh")
  diaChi      String?   @map("dia_chi")
  soDienThoai String?   @map("so_dien_thoai")
  email       String?   @unique
  anhDaiDien  String?   @map("anh_dai_dien")

  taoLuc     DateTime @default(now()) @map("tao_luc")
  capNhatLuc DateTime @updatedAt @map("cap_nhat_luc")

  phong    Phong     @relation(fields: [maPhong], references: [maPhong])
  taiKhoan TaiKhoan?

  // Kế hoạch/Báo cáo tuần
  keHoachTuans         KeHoachTuan[]        @relation("KeHoachNguoiLienQuan")
  keHoachCapNhat       KeHoachTuan[]        @relation("KeHoachNguoiCapNhat")
  keHoachPhoiHop       KeHoachTuanPhoiHop[]
  keHoachDanhDauPhong  KeHoachTuan[]        @relation("KeHoachNguoiDanhDauPhong")
  keHoachLoaiKhoiPhong KeHoachTuan[]        @relation("KeHoachNguoiLoaiKhoiPhong")
  keHoachXoa           KeHoachTuan[]        @relation("KeHoachNguoiXoa")

  // Nhiệm vụ
  nhiemVuTao       NhiemVu[]             @relation("NhiemVuNguoiTao")
  nhiemVuGiao      NhiemVu[]             @relation("NhiemVuNguoiGiao")
  nhiemVuXuLyChinh NhiemVu[]             @relation("NhiemVuNguoiXuLy")
  nhiemVuBaoCao    NhiemVu[]             @relation("NhiemVuNguoiBaoCao")
  nhiemVuDuyet     NhiemVu[]             @relation("NhiemVuNguoiDuyet")
  nhiemVuCapNhat   NhiemVu[]             @relation("NhiemVuNguoiCapNhat")
  nhiemVuXoa       NhiemVu[]             @relation("NhiemVuNguoiXoa")
  nhiemVuPhoiHop   NhiemVuNguoiPhoiHop[]
  nhiemVuLogs      NhiemVuLog[]

  // Subtask
  nhiemVuSubTaskHoanThanh NhiemVuSubTask[] @relation("NVSubTaskNguoiHoanThanh")
  nhiemVuSubTaskTao       NhiemVuSubTask[] @relation("NVSubTaskNguoiTao")

  // Thông báo
  thongBaoNhan ThongBao[]
  nhacViecDaNhan NhacViecDaGui[]

  // MỚI — Giao ban
  cuocHopGiaoBanTao       CuocHopGiaoBan[]          @relation("GiaoBanCuocHopNguoiTao")
  noiDungGiaoBanTao       NoiDungGiaoBan[]          @relation("GiaoBanNoiDungNguoiTao")
  noiDungGiaoBanHoanThanh NoiDungGiaoBan[]          @relation("GiaoBanNguoiHoanThanh")
  noiDungGiaoBanXoa       NoiDungGiaoBan[]          @relation("GiaoBanNoiDungNguoiXoa")
  noiDungGiaoBanXuLy      NoiDungGiaoBanNguoiXuLy[]
  noiDungGiaoBanLogs      NoiDungGiaoBanLog[]       @relation("GiaoBanLogNguoiThucHien")

  @@index([maPhong, thuTu])
  @@map("nhan_vien")
}

model TaiKhoan {
  id              Int       @id @default(autoincrement())
  maNV            String    @unique @map("ma_nv")
  tenDangNhap     String    @unique @map("ten_dang_nhap")
  matKhauHash     String    @map("mat_khau_hash")
  isAdmin         Boolean   @default(false) @map("is_admin")
  lanDangNhapCuoi DateTime? @map("lan_dang_nhap_cuoi")
  taoLuc          DateTime  @default(now()) @map("tao_luc")

  biKhoa                   Boolean   @default(false) @map("bi_khoa")
  soLanDangNhapSaiLienTiep  Int       @default(0) @map("so_lan_dang_nhap_sai_lien_tiep")
  khoaLuc                   DateTime? @map("khoa_luc")
  lyDoKhoa                  String?   @map("ly_do_khoa")

  nhanVien NhanVien @relation(fields: [maNV], references: [maNV], onDelete: Cascade)

  @@map("tai_khoan")
}

// ==========================================================================================
// ====================     KẾ HOẠCH / BÁO CÁO TUẦN (gộp CANHAN + PHONG)   =================
// ==========================================================================================

model KeHoachTuan {
  id          Int         @id @default(autoincrement())
  nam         Int
  tuan        Int
  loai        LoaiGhiNhan
  maPhong     String      @map("ma_phong")
  maNV        String      @map("ma_nv")
  noiDung     String      @map("noi_dung") @db.Text
  ketQua      String?     @map("ket_qua") @db.Text
  daHoanThanh Boolean     @default(false) @map("da_hoan_thanh")
  thoiGianHoanThanh DateTime? @map("thoi_gian_hoan_thanh")
  ghiChu      String?     @map("ghi_chu") @db.Text

  ghiChuPhoiHop String? @map("ghi_chu_phoi_hop")

  laCuaCaNhan Boolean @default(false) @map("la_cua_ca_nhan")
  laCuaPhong  Boolean @default(false) @map("la_cua_phong")

  hanXuLy DateTime? @map("han_xu_ly") @db.Date

  // Tiến độ % (0-100) — có CHECK constraint DB bổ sung ở migration (xem migration-check-constraints.sql)
  tienDo Int? @map("tien_do")

  nguoiDanhDauPhongId   String?   @map("nguoi_danh_dau_phong_id")
  thoiGianDanhDauPhong  DateTime? @map("thoi_gian_danh_dau_phong")
  nguoiLoaiKhoiPhongId  String?   @map("nguoi_loai_khoi_phong_id")
  thoiGianLoaiKhoiPhong DateTime? @map("thoi_gian_loai_khoi_phong")

  isDeleted  Boolean   @default(false) @map("is_deleted")
  xoaLuc     DateTime? @map("xoa_luc")
  nguoiXoaId String?   @map("nguoi_xoa_id")

  nguoiCapNhatId String?  @map("nguoi_cap_nhat_id")
  ngayCapNhat    DateTime @updatedAt @map("ngay_cap_nhat")
  taoLuc         DateTime @default(now()) @map("tao_luc")

  phong              Phong     @relation(fields: [maPhong], references: [maPhong])
  nhanVien           NhanVien  @relation("KeHoachNguoiLienQuan", fields: [maNV], references: [maNV])
  nguoiCapNhat       NhanVien? @relation("KeHoachNguoiCapNhat", fields: [nguoiCapNhatId], references: [maNV])
  nguoiDanhDauPhong  NhanVien? @relation("KeHoachNguoiDanhDauPhong", fields: [nguoiDanhDauPhongId], references: [maNV])
  nguoiLoaiKhoiPhong NhanVien? @relation("KeHoachNguoiLoaiKhoiPhong", fields: [nguoiLoaiKhoiPhongId], references: [maNV])
  nguoiXoa           NhanVien? @relation("KeHoachNguoiXoa", fields: [nguoiXoaId], references: [maNV])

  nguoiPhoiHop KeHoachTuanPhoiHop[]

  // Nhiệm vụ được "nâng cấp" từ dòng Kế hoạch này (1-1, optional, phía FK nằm ở NhiemVu.nguonKeHoachTuanId)
  nhiemVuDuocTao NhiemVu?

  // MỚI — Giao ban: nhiều bản ghi NoiDungGiaoBan (qua nhiều tuần carry-over) có thể cùng trỏ về
  // đúng 1 KeHoachTuan này — KHÔNG @unique ở đây, ràng buộc "chỉ 1 bản ghi đang sống" nằm ở
  // partial unique index phía NoiDungGiaoBan (xem migration-giao-ban-partial-unique-index.sql).
  noiDungGiaoBans NoiDungGiaoBan[]

  @@index([nam, tuan, loai])
  @@index([maPhong, nam, tuan, laCuaPhong])
  @@index([maNV, nam, tuan, laCuaCaNhan])
  @@index([isDeleted])
  @@map("ke_hoach_tuan")
}

model KeHoachTuanPhoiHop {
  id            Int    @id @default(autoincrement())
  keHoachTuanId Int    @map("ke_hoach_tuan_id")
  maNV          String @map("ma_nv")

  keHoachTuan KeHoachTuan @relation(fields: [keHoachTuanId], references: [id], onDelete: Cascade)
  nhanVien    NhanVien    @relation(fields: [maNV], references: [maNV])

  @@unique([keHoachTuanId, maNV])
  @@map("ke_hoach_tuan_phoi_hop")
}

// ==========================================================================================
// ====================                  NHIỆM VỤ                         =================
// ==========================================================================================

model NhiemVu {
  id             Int         @id @default(autoincrement())
  tieuDe         String      @map("tieu_de")
  noiDung        String?     @map("noi_dung") @db.Text
  mucDoUuTien    MucDoUuTien @default(THUONG) @map("muc_do_uu_tien")
  nguon          String?
  vanBanLienQuan String?     @map("van_ban_lien_quan")
  linkFile       String?     @map("link_file") // chỉ nhập LINK, không upload file thật

  nguoiTaoId  String    @map("nguoi_tao_id")
  nguoiGiaoId String    @map("nguoi_giao_id") // mặc định = nguoiTaoId, cho đổi. Chọn trong: LĐ của PHÒNG CHỦ TRÌ + toàn bộ BGĐ — validate server-side
  ngayGiao    DateTime  @default(now()) @map("ngay_giao")
  hanXuLy     DateTime? @map("han_xu_ly") @db.Date

  phongChuTriId    String  @map("phong_chu_tri_id") // nguồn sự thật duy nhất — sửa được (đổi phòng chủ trì, chỉ BGĐ)
  nguoiXuLyChinhId String? @map("nguoi_xu_ly_chinh_id") // có thể trống lúc tạo

  trangThai      TrangThaiNhiemVu @default(CHO_PHAN_CONG) @map("trang_thai")
  tienDoPhanTram Int              @default(0) @map("tien_do_phan_tram") // 0-100, CHECK constraint DB
  ketQua         String?          @map("ket_qua") @db.Text // kết quả HIỆN TẠI — lịch sử báo cáo trước lưu ở NhiemVuLog.ghiChu

  nguoiBaoCaoHoanThanhId String?   @map("nguoi_bao_cao_hoan_thanh_id")
  nguoiDuyetId           String?   @map("nguoi_duyet_id") // CHỈ set khi thực sự duyệt, không chọn trước
  thoiGianHoanThanh      DateTime? @map("thoi_gian_hoan_thanh") // LẦN GẦN NHẤT

  ngayCapNhat    DateTime @updatedAt @map("ngay_cap_nhat")
  nguoiCapNhatId String?  @map("nguoi_cap_nhat_id")

  isDeleted  Boolean   @default(false) @map("is_deleted")
  xoaLuc     DateTime? @map("xoa_luc")
  nguoiXoaId String?   @map("nguoi_xoa_id")

  // ===== NHẮC VIỆC ĐỊNH KỲ =====
  tanSuatNhac      TanSuatNhac?  @map("tan_suat_nhac")
  ngayBatDauNhac   DateTime?     @db.Date @map("ngay_bat_dau_nhac") // mốc gốc, tự suy "thứ mấy/ngày mấy"
  ngayKetThucNhac  DateTime?     @db.Date @map("ngay_ket_thuc_nhac") // null = vô thời hạn
  ngayNhacTiepTheo DateTime?     @db.Date @map("ngay_nhac_tiep_theo") // cache, tính lại mỗi lần "xong đợt"
  dungNhacLai      Boolean       @default(false) @map("dung_nhac_lai")
  soDotDaXong      Int           @default(0) @map("so_dot_da_xong")

  // ===== LIÊN KẾT NGUỒN GỐC (Kế hoạch cá nhân → nâng cấp thành Nhiệm vụ) =====
  nguonKeHoachTuanId Int? @unique @map("nguon_ke_hoach_tuan_id")

  nguoiTao       NhanVien    @relation("NhiemVuNguoiTao", fields: [nguoiTaoId], references: [maNV])
  nguoiGiao      NhanVien    @relation("NhiemVuNguoiGiao", fields: [nguoiGiaoId], references: [maNV])
  phongChuTri    Phong       @relation("NhiemVuPhongChuTri", fields: [phongChuTriId], references: [maPhong])
  nguoiXuLyChinh NhanVien?   @relation("NhiemVuNguoiXuLy", fields: [nguoiXuLyChinhId], references: [maNV])
  nguoiBaoCao    NhanVien?   @relation("NhiemVuNguoiBaoCao", fields: [nguoiBaoCaoHoanThanhId], references: [maNV])
  nguoiDuyet     NhanVien?   @relation("NhiemVuNguoiDuyet", fields: [nguoiDuyetId], references: [maNV])
  nguoiCapNhat   NhanVien?   @relation("NhiemVuNguoiCapNhat", fields: [nguoiCapNhatId], references: [maNV])
  nguoiXoa       NhanVien?   @relation("NhiemVuNguoiXoa", fields: [nguoiXoaId], references: [maNV])
  nguonKeHoachTuan KeHoachTuan? @relation(fields: [nguonKeHoachTuanId], references: [id])

  phongPhoiHop NhiemVuPhong[]
  nguoiPhoiHop NhiemVuNguoiPhoiHop[]
  logs         NhiemVuLog[]
  subTasks     NhiemVuSubTask[]

  // MỚI — Giao ban: KHÔNG @unique — nhiemVuId được giữ trên MỌI bản ghi trong chuỗi carry-over
  // (nhiều dòng NoiDungGiaoBan có thể cùng trỏ về NhiemVu này, miễn chỉ 1 dòng "đang sống" tại 1
  // thời điểm — ràng buộc đó nằm ở partial unique index, không phải ở phía NhiemVu).
  noiDungGiaoBans NoiDungGiaoBan[]

  @@index([trangThai])
  @@index([phongChuTriId])
  @@index([nguoiXuLyChinhId])
  @@index([hanXuLy])
  @@index([isDeleted])
  @@index([isDeleted, trangThai, hanXuLy])
  @@index([tanSuatNhac, dungNhacLai, ngayNhacTiepTheo])
  @@map("nhiem_vu")
}

model NhiemVuPhong { // chỉ chứa PHÒNG PHỐI HỢP — chủ trì đã có ở NhiemVu.phongChuTriId
  id        Int    @id @default(autoincrement())
  nhiemVuId Int    @map("nhiem_vu_id")
  maPhong   String @map("ma_phong")

  nhiemVu NhiemVu @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  phong   Phong   @relation(fields: [maPhong], references: [maPhong])

  @@unique([nhiemVuId, maPhong])
  @@map("nhiem_vu_phong")
}

model NhiemVuNguoiPhoiHop {
  id            Int      @id @default(autoincrement())
  nhiemVuId     Int      @map("nhiem_vu_id")
  maNV          String   @map("ma_nv")
  maPhong       String?  @map("ma_phong") // snapshot FK — dùng cho truy vấn nhanh hiện tại
  tenPhongLucDo String?  @map("ten_phong_luc_do") // snapshot TEXT THUẦN, không FK — "ảnh chụp" tên
                                                    // phòng tại thời điểm thêm, KHÔNG bị ảnh hưởng
                                                    // nếu Phong sau này đổi tên/mã (đơn vị đã từng
                                                    // sáp nhập tỉnh — rủi ro có thật, không giả định)
  ngayThem      DateTime @default(now()) @map("ngay_them")
  ghiChu        String?  @map("ghi_chu") // ghi chú đóng góp — CHỈ chính người phối hợp đó được sửa

  // MỚI — cho phép người phối hợp tự đánh dấu ĐÃ HOÀN THÀNH PHẦN VIỆC của họ (khác với trạng thái
  // TỔNG THỂ của cả NhiemVu, do người xử lý chính/LĐ phòng quản lý). Không ảnh hưởng tienDoPhanTram
  // chung — chỉ là theo dõi riêng cho từng người phối hợp, để người giao/LĐ biết ai đã xong phần
  // của mình, ai chưa.
  daHoanThanhPhanViec      Boolean   @default(false) @map("da_hoan_thanh_phan_viec")
  thoiGianHoanThanhPhanViec DateTime? @map("thoi_gian_hoan_thanh_phan_viec")

  nhiemVu  NhiemVu  @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  nhanVien NhanVien @relation(fields: [maNV], references: [maNV])
  phong    Phong?   @relation(fields: [maPhong], references: [maPhong])

  @@unique([nhiemVuId, maNV])
  @@map("nhiem_vu_nguoi_phoi_hop")
}

model NhiemVuLog {
  id              Int             @id @default(autoincrement())
  nhiemVuId       Int             @map("nhiem_vu_id")
  thoiGian        DateTime        @default(now()) @map("thoi_gian")
  hanhDong        HanhDongNhiemVu @map("hanh_dong")
  nguoiThucHienId String          @map("nguoi_thuc_hien_id")
  tuGiaTri        String?         @map("tu_gia_tri")  // maNV/maPhong/text cũ — QUY ƯỚC CHẶT ở tầng code
  denGiaTri       String?         @map("den_gia_tri")
  ghiChu          String?         @map("ghi_chu") @db.Text

  nhiemVu       NhiemVu  @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  nguoiThucHien NhanVien @relation(fields: [nguoiThucHienId], references: [maNV])

  @@index([nhiemVuId, thoiGian])
  @@map("nhiem_vu_log")
}

model NhiemVuSubTask {
  id                Int       @id @default(autoincrement())
  nhiemVuId         Int       @map("nhiem_vu_id")
  noiDung           String
  thuTu             Int       @default(0) @map("thu_tu")
  daHoanThanh       Boolean   @default(false) @map("da_hoan_thanh")
  nguoiHoanThanhId  String?   @map("nguoi_hoan_thanh_id")
  thoiGianHoanThanh DateTime? @map("thoi_gian_hoan_thanh")
  nguoiTaoId        String    @map("nguoi_tao_id")
  taoLuc            DateTime  @default(now()) @map("tao_luc")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  capNhatLuc        DateTime  @updatedAt @map("cap_nhat_luc")

  nhiemVu        NhiemVu   @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  nguoiHoanThanh NhanVien? @relation("NVSubTaskNguoiHoanThanh", fields: [nguoiHoanThanhId], references: [maNV])
  nguoiTao       NhanVien  @relation("NVSubTaskNguoiTao", fields: [nguoiTaoId], references: [maNV])

  @@index([nhiemVuId, thuTu])
  @@map("nhiem_vu_sub_task")
}

// ==========================================================================================
// ====================                 THÔNG BÁO                         =================
// ==========================================================================================
// Hộp thư trong app, sinh NGAY khi có hành động (khác NhacViecDaGui — sổ chống trùng cho cron gửi
// nhắc theo mốc thời gian, sẽ thêm ở Phase 6). Dùng song song, không thay thế nhau.

model ThongBao {
  id          Int          @id @default(autoincrement())
  nguoiNhanId String       @map("nguoi_nhan_id")
  tieuDe      String
  noiDung     String?      @db.Text
  loai        LoaiThongBao
  duongDan    String?      @map("duong_dan") // link khi bấm vào, VD "/nhiem-vu/12"
  daDoc       Boolean      @default(false) @map("da_doc")
  taoLuc      DateTime     @default(now()) @map("tao_luc")

  nguoiNhan NhanVien @relation(fields: [nguoiNhanId], references: [maNV])

  @@index([nguoiNhanId, daDoc])
  @@index([nguoiNhanId, taoLuc])
  @@map("thong_bao")
}

// ==========================================================================================
// ====================        SỔ CHỐNG TRÙNG NHẮC VIỆC (cho cron)        =================
// ==========================================================================================
// Khác ThongBao (hộp thư sinh NGAY khi có hành động) — bảng này phục vụ CRON chủ động quét và gửi
// nhắc theo mốc thời gian (VD: nhắc trước 3 ngày khi sắp tới hạn). Dùng chung cho mọi loại "hạn"
// trong hệ thống qua cột loaiDoiTuong (Nhiệm vụ có hạn / Nhiệm vụ định kỳ / mở rộng Kế hoạch cá
// nhân sau này) — không cần thêm bảng mới mỗi khi mở rộng loại nhắc.

enum LoaiDoiTuongNhac {
  NHIEM_VU_HAN
  NHIEM_VU_DINHKY
  KE_HOACH_HAN // chỗ mở rộng sẵn cho Kế hoạch cá nhân sau này — KHÔNG cần sửa bảng KeHoachTuan
}

enum KenhNhac {
  EMAIL
  APP // ghi nhận đã gửi qua kênh app (đồng thời với việc tạo 1 dòng ThongBao tương ứng)
}

model NhacViecDaGui {
  id           Int              @id @default(autoincrement())
  loaiDoiTuong LoaiDoiTuongNhac @map("loai_doi_tuong")
  doiTuongId   Int              @map("doi_tuong_id") // id của NhiemVu/KeHoachTuan — KHÔNG FK thật (polymorphic), an toàn nhờ soft-delete ở bảng nguồn
  ngayMoc      DateTime         @db.Date @map("ngay_moc") // NGÀY DỰ KIẾN GỬI (vd hạn-3ngày), KHÔNG PHẢI ngày hạn thật
  kenh         KenhNhac
  nguoiNhanId  String           @map("nguoi_nhan_id")
  guiLuc       DateTime         @default(now()) @map("gui_luc")

  nguoiNhan NhanVien @relation(fields: [nguoiNhanId], references: [maNV])

  // Nguyên tắc chống trùng: CHỈ insert dòng này SAU KHI gửi thành công — không lưu cờ trạng thái
  // thất bại. Gửi lỗi thì không ghi gì, lần cron sau tự coi là chưa gửi -> tự retry.
  @@unique([loaiDoiTuong, doiTuongId, ngayMoc, kenh, nguoiNhanId])
  @@index([loaiDoiTuong, doiTuongId])
  @@map("nhac_viec_da_gui")
}

// ==========================================================================================
// ====================        CHECKLIST GIAO BAN (MỚI)                    ================
// ==========================================================================================
// Theo đúng "Đặc tả tính năng Checklist giao ban - cái chính bắt buộc theo.md".
// Quy ước ĐẶC THÙ cho tính năng này (khác quy ước taoLuc/ngayCapNhat/xoaLuc/nguoiXoaId đang dùng
// ở NhiemVu/KeHoachTuan): đặc tả yêu cầu literal createdAt/updatedAt/createdById/deletedAt/
// deletedById — giữ đúng tên field, chỉ thêm @map snake_case cho khớp cột DB.

model CuocHopGiaoBan {
  id        Int                     @id @default(autoincrement())
  tuan      Int
  nam       Int
  ngayHop   DateTime                @db.Date @map("ngay_hop")
  trangThai TrangThaiCuocHopGiaoBan @default(DANG_MO) @map("trang_thai")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy NhanVien         @relation("GiaoBanCuocHopNguoiTao", fields: [createdById], references: [maNV])
  noiDungs  NoiDungGiaoBan[]

  @@unique([nam, tuan])
  @@index([trangThai])
  @@map("cuoc_hop_giao_ban")
}

// Mỗi lần xuất hiện tại 1 tuần là 1 dòng riêng — KHÔNG có bảng nối N:N sang CuocHopGiaoBan.
model NoiDungGiaoBan {
  id               Int @id @default(autoincrement())
  cuocHopGiaoBanId Int @map("cuoc_hop_giao_ban_id")

  noiDung String @map("noi_dung") @db.Text

  // Nguồn: đúng 1 trong 2 khác null, hoặc cả 2 null (nhập trực tiếp). Giữ nguyên trên MỌI bản ghi
  // trong chuỗi carry-over — không chỉ bản ghi gốc.
  nhiemVuId     Int? @map("nhiem_vu_id")
  keHoachTuanId Int? @map("ke_hoach_tuan_id")

  // Mã chuỗi độc lập, tự sinh, KHÔNG phải FK trỏ tới bản ghi nào — nối các bản ghi carry-over của
  // cùng 1 công việc xuyên nhiều tuần.
  chuoiNoiDungId String @default(cuid()) @map("chuoi_noi_dung_id")

  // Bản ghi tuần NGAY TRƯỚC đã sinh ra bản ghi này — UNIQUE để 1 bản ghi cũ chỉ được làm nguồn cho
  // đúng 1 bản ghi mới (chống chuyển tuần trùng).
  nguonNoiDungGiaoBanId Int? @unique @map("nguon_noi_dung_giao_ban_id")

  phongXuLyId  String             @map("phong_xu_ly_id") // bắt buộc
  hanHoanThanh DateTime           @db.Date @map("han_hoan_thanh")
  mucDoUuTien  MucDoUuTienGiaoBan @map("muc_do_uu_tien")

  daHoanThanh       Boolean   @default(false) @map("da_hoan_thanh")
  nguoiHoanThanhId  String?   @map("nguoi_hoan_thanh_id")
  thoiGianHoanThanh DateTime? @map("thoi_gian_hoan_thanh")

  // daKetThuc: bản ghi đã kết thúc theo dõi (hoàn thành/chuyển tuần/huỷ) — KHÁC daHoanThanh.
  // deNghiChuyenTuan: đã đề nghị nhưng CHƯA tạo bản ghi tuần mới.
  daKetThuc        Boolean @default(false) @map("da_ket_thuc")
  deNghiChuyenTuan Boolean @default(false) @map("de_nghi_chuyen_tuan")

  ghiChu String? @map("ghi_chu") @db.Text // KHÔNG bị ghi đè khi đồng bộ từ nguồn

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  cuocHopGiaoBan CuocHopGiaoBan @relation(fields: [cuocHopGiaoBanId], references: [id])
  nhiemVu        NhiemVu?       @relation(fields: [nhiemVuId], references: [id])
  keHoachTuan    KeHoachTuan?   @relation(fields: [keHoachTuanId], references: [id])
  phongXuLy      Phong          @relation(fields: [phongXuLyId], references: [maPhong])
  nguoiHoanThanh NhanVien?      @relation("GiaoBanNguoiHoanThanh", fields: [nguoiHoanThanhId], references: [maNV])
  createdBy      NhanVien       @relation("GiaoBanNoiDungNguoiTao", fields: [createdById], references: [maNV])
  deletedBy      NhanVien?      @relation("GiaoBanNoiDungNguoiXoa", fields: [deletedById], references: [maNV])

  // Tự tham chiếu 1-1: bản ghi cũ (nguon) <-> bản ghi mới được sinh ra từ nó (duocChuyenThanh)
  nguonNoiDungGiaoBan NoiDungGiaoBan? @relation("GiaoBanChuyenTuan", fields: [nguonNoiDungGiaoBanId], references: [id])
  duocChuyenThanh     NoiDungGiaoBan? @relation("GiaoBanChuyenTuan")

  nguoiXuLys NoiDungGiaoBanNguoiXuLy[]
  logs       NoiDungGiaoBanLog[]

  @@unique([nhiemVuId, cuocHopGiaoBanId])
  @@unique([keHoachTuanId, cuocHopGiaoBanId])
  @@index([cuocHopGiaoBanId, isDeleted, daKetThuc])
  @@index([chuoiNoiDungId])
  @@index([nhiemVuId])
  @@index([keHoachTuanId])
  @@index([phongXuLyId])
  @@map("noi_dung_giao_ban")
}

model NoiDungGiaoBanNguoiXuLy {
  id               Int      @id @default(autoincrement())
  noiDungGiaoBanId Int      @map("noi_dung_giao_ban_id")
  nhanVienId       String   @map("nhan_vien_id")
  createdAt        DateTime @default(now()) @map("created_at")

  noiDungGiaoBan NoiDungGiaoBan @relation(fields: [noiDungGiaoBanId], references: [id], onDelete: Cascade)
  nhanVien       NhanVien       @relation(fields: [nhanVienId], references: [maNV])

  @@unique([noiDungGiaoBanId, nhanVienId])
  @@map("noi_dung_giao_ban_nguoi_xu_ly")
}

// Audit log — 1 hành động = 1 log.
model NoiDungGiaoBanLog {
  id               Int             @id @default(autoincrement())
  noiDungGiaoBanId Int             @map("noi_dung_giao_ban_id")
  nguoiThucHienId  String          @map("nguoi_thuc_hien_id")
  thoiGian         DateTime        @default(now()) @map("thoi_gian")
  thaoTac          HanhDongGiaoBan @map("thao_tac")
  truongDuocSua    String?         @map("truong_duoc_sua")
  giaTriCu         String?         @map("gia_tri_cu") @db.Text
  giaTriMoi        String?         @map("gia_tri_moi") @db.Text

  noiDungGiaoBan NoiDungGiaoBan @relation(fields: [noiDungGiaoBanId], references: [id], onDelete: Cascade)
  nguoiThucHien  NhanVien       @relation("GiaoBanLogNguoiThucHien", fields: [nguoiThucHienId], references: [maNV])

  @@index([noiDungGiaoBanId, thoiGian])
  @@map("noi_dung_giao_ban_log")
}
